# Copy this file to .env.local and fill in values
# Never commit .env.local

# Skin-scan service (server-only proxy target — /api/skin-scan route).
# No deployed target exists yet as of this extraction — see README_PORT.md.
SKIN_SCAN_API_URL=http://localhost:8000

# Shared secret the /api/skin-scan proxy sends as X-Scan-Secret to the
# skin-scan service. Required — without it the proxy route 500s
# (SCAN_MISCONFIGURED) before ever calling the service.
SCAN_API_SECRET=

# Gemini — server-only, never prefix with NEXT_PUBLIC_.
# GEMINI_API_KEY: Google AI Studio → Get API key.
# GEMINI_MODEL_VISION / GEMINI_MODEL_SYNTHESIS: optional overrides. Defaults in
# lib/gemini.ts are gemini-2.5-flash for both.
GEMINI_API_KEY=
GEMINI_MODEL_VISION=
GEMINI_MODEL_SYNTHESIS=

# Read by next.config.js (logging.fetches.fullUrl). Optional — safe when unset.
NEXT_PUBLIC_APP_ENV=development

# Optional. Client-safe (not a secret) — the storefront's real Terms &
# Conditions page, linked from the photo-capture consent checkbox
# (components/skin-check/inputs/PhotoCapture.tsx). Left unset, the checkbox
# label still renders and still gates the scan; it just isn't a hyperlink.
NEXT_PUBLIC_TERMS_URL=

# Firebase — all client-safe. The web config identifies the project; it
# authorizes nothing on its own. Access is decided by Firebase Auth and
# firestore.rules, never by keeping these secret, which is why every one is
# NEXT_PUBLIC_. Regenerate with:
#   npx -y firebase-tools@latest apps:sdkconfig WEB <APP_ID> --project projectskin-a202c
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ─── Firebase Admin (SERVER ONLY — Phase 2 trust boundary) ─────────────────
# Service-account credentials used by lib/firebase/admin.ts to verify the
# Firebase ID token on every POST /api/skin-scan. NEVER prefix these with
# NEXT_PUBLIC_ and never commit real values — the private key can mint tokens
# for the entire Firebase project.
#
# Get them from: Firebase Console → Project settings → Service accounts →
# "Generate new private key". That downloads a JSON file; copy three fields
# out of it and DELETE the file (*.json service-account keys are gitignored,
# but the safest key on disk is the one that isn't).
#
#   project_id   → FIREBASE_PROJECT_ID    (optional; falls back to
#                                          NEXT_PUBLIC_FIREBASE_PROJECT_ID)
#   client_email → FIREBASE_CLIENT_EMAIL
#   private_key  → FIREBASE_PRIVATE_KEY
#
# FIREBASE_PRIVATE_KEY must keep its literal \n escapes and be quoted, exactly
# as it appears in the JSON — admin.ts converts them back to real newlines:
#   FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
#
# On Vercel: add all three as Environment Variables (not NEXT_PUBLIC_), marked
# Sensitive. Without them /api/skin-scan returns 500 AUTH_MISCONFIGURED — it
# fails closed, it never falls back to skipping verification.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ─── Private S3 original-image storage (SERVER ONLY — Phase 3) ─────────────
# Where every scan's ORIGINAL image is stored:
#   users/{verified Firebase uid}/scans/{scanId}/original.jpg
# The browser never sees a bucket name, a region, or a credential — it asks
# /api/skin-scan/upload for a 5-minute presigned PUT and the server builds the
# key from the uid in the verified ID token. NEVER prefix these NEXT_PUBLIC_.
#
# Provisioned values live in DEPLOYMENT.md (bucket projectskin-skin-originals-prod,
# ap-south-1, IAM user skin-check-uploader). Set all four in Vercel, the last
# two marked Sensitive.
S3_SKIN_IMAGES_BUCKET=
# Required. There is no AWS_REGION fallback: Vercel injects its own AWS_REGION
# (the function's region), so a fallback would sign for the wrong region
# instead of failing closed.
S3_SKIN_IMAGES_REGION=

# Credentials for the s3:PutObject-only IAM user. Deliberately NOT named
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY: Vercel's function runtime can
# inject its own AWS_* values (including AWS_SESSION_TOKEN), and the SDK's env
# provider reads all three together — a half-overridden set signs with our key
# and Vercel's stale session token and fails as InvalidToken.
#
# Leave both UNSET to use the standard AWS provider chain instead (a local
# ~/.aws profile, an execution role, or Vercel's AWS OIDC integration).
S3_SKIN_IMAGES_ACCESS_KEY_ID=
S3_SKIN_IMAGES_SECRET_ACCESS_KEY=
#
# Least privilege — the only permission the app needs:
#   {
#     "Effect": "Allow",
#     "Action": "s3:PutObject",
#     "Resource": "arn:aws:s3:::<bucket>/users/*/scans/*/original.jpg"
#   }
