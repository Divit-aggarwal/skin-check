# Copy this file to .env.local and fill in values
# Never commit .env.local

# Skin-scan service (server-only proxy target — /api/skin-scan route).
# No deployed target exists yet as of this extraction — see README_PORT.md.
SKIN_SCAN_API_URL=http://localhost:8000

# Shared secret the /api/skin-scan proxy sends as X-Scan-Secret to the
# skin-scan service. Required — without it the proxy route 500s
# (SCAN_MISCONFIGURED) before ever calling the service.
SCAN_API_SECRET=

# Gemini — server-only, never prefix with NEXT_PUBLIC_.
# GEMINI_API_KEY: Google AI Studio → Get API key.
# GEMINI_MODEL_VISION / GEMINI_MODEL_SYNTHESIS: optional overrides. Defaults in
# lib/gemini.ts are gemini-2.5-flash for both.
GEMINI_API_KEY=
GEMINI_MODEL_VISION=
GEMINI_MODEL_SYNTHESIS=

# Read by next.config.js (logging.fetches.fullUrl). Optional — safe when unset.
NEXT_PUBLIC_APP_ENV=development

# Optional. Client-safe (not a secret) — the storefront's real Terms &
# Conditions page, linked from the photo-capture consent checkbox
# (components/skin-check/inputs/PhotoCapture.tsx). Left unset, the checkbox
# label still renders and still gates the scan; it just isn't a hyperlink.
NEXT_PUBLIC_TERMS_URL=

# Supabase Auth — client-safe. The publishable key is meant to be public: it
# carries no privilege beyond what RLS grants the `anon`/`authenticated`
# roles. Get both from Project Settings → API Keys. Never put a
# service_role/secret key behind a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
