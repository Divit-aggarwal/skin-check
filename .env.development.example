# Local development stack (tracker B01). No production keys, no real secrets.
#
# `npm run dev:local` copies this file to .env.development.local on first run.
# In `next dev` that file outranks .env.local, so every name below overrides
# a production value that .env.local may still hold. Keep every name here.
#
# Ports shown are for the main checkout (PORT_BASE=3100). scripts/local-stack.sh
# exports the port-dependent values for the checkout's PORT_BASE (lanes use
# .env.lane), and exported values beat this file.

NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_TERMS_URL=

# Firebase: emulator project. "demo-" projects cannot reach real Firebase.
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-skin-check.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-skin-check
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-skin-check.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:3101
NEXT_PUBLIC_FIRESTORE_EMULATOR_HOST=127.0.0.1:3102
FIREBASE_PROJECT_ID=demo-skin-check
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:3101
FIRESTORE_EMULATOR_HOST=127.0.0.1:3102
# Not used for Firebase with the emulators. FIREBASE_PRIVATE_KEY only seeds
# the Echo history MAC locally; any non-empty dummy works.
FIREBASE_CLIENT_EMAIL=local-dev@demo-skin-check.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY=local-dev-not-a-key

# Engine: the local 0.1.6 image (sha256:9a8f96c0...) run by the stack script.
SKIN_SCAN_API_URL=http://127.0.0.1:3107
SCAN_API_SECRET=local-dev-scan-secret

# Image storage: S3Mock (S3-compatible, accepts any credentials).
S3_SKIN_IMAGES_ENDPOINT=http://127.0.0.1:3108
S3_SKIN_IMAGES_REGION=ap-south-1
S3_SKIN_IMAGES_BUCKET=skin-originals-dev
S3_SKIN_IMAGES_ACCESS_KEY_ID=local-dev
S3_SKIN_IMAGES_SECRET_ACCESS_KEY=local-dev

# Gemini: `next dev` reads GEMINI_DEV_API_KEY only. Leave it empty and Echo
# answers 500 CHAT_MISCONFIGURED; the owner puts a separate dev key in
# .env.development.local later. GEMINI_API_KEY is blanked so the production
# key is never loaded. Tests use a fake (vi.mock) and need no key.
GEMINI_API_KEY=
GEMINI_DEV_API_KEY=
GEMINI_MODEL_VISION=
GEMINI_MODEL_SYNTHESIS=

# Vercel CLI token from .env.local; not used locally.
VERCEL_OIDC_TOKEN=

# lane:privacy. H01b erasure credentials (decision 11a): a separate pair from
# the upload key. S3Mock accepts any value; production uses the owner's erase
# IAM principal. lib/dev-env-guard.cjs must learn these names (request R5).
S3_SKIN_IMAGES_ERASE_ACCESS_KEY_ID=local-dev-erase
S3_SKIN_IMAGES_ERASE_SECRET_ACCESS_KEY=local-dev-erase

# lane:context. Owner decision O-4: the context-package Echo path is on for
# local development only. lib/context/switch.ts ignores this in production
# builds (NODE_ENV=production), so it can never switch the path on there.
ECHO_CONTEXT_PATH=on
